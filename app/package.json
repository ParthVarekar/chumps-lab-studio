    "react-moveable": "^0.56.0",
    "react-resizable-panels": "^4.19.0",
    "remotion": "4.0.541",
    "serve-handler": "6.1.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "puppeteer-core": "^25.16.0",
