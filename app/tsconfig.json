{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": [
      "DOM",
      "ES2023"
    ],
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "shared",
    "server",
    "test"
  ]
}